# Model backend for the AutoGen agents.
# Default (unset, or "mock") runs the deterministic, KPI-grounded rule-based
# model client in agents/model_client.py -- no API key needed, fully offline.
#
# Set to "anthropic" or "openai" + the matching key below to swap every agent
# to a real hosted LLM with zero other code changes.
MODEL_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google AI Studio key, used via Gemini's OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
